rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only touch their own attempts.
    match /users/{uid}/attempts/{attemptId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['juz','started','finished','marks','total','timeout','slots','at'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 60
        && request.resource.data.at == request.time;
    }
  }
}
